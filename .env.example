# ── Site ──
NEXT_PUBLIC_SITE_URL=https://swadeshimahadevproducts.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919251005103
COMMERCE_PROVIDER=db

# ── MySQL (Hostinger: host 127.0.0.1 from the Node app on the same server) ──
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# ── Cashfree (dashboard → Developers → API Keys). CASHFREE_ENV=sandbox|production ──
# Pick PayU or Cashfree in /admin/settings → Online payments. Webhook URL: https://<site>/api/cashfree/webhook
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# ── PayU (dashboard → Developers → Key & Salt). PAYU_MODE=test|live ──
PAYU_MODE=test
PAYU_KEY=
PAYU_SALT=

# ── Admin panel login (/admin, HTTP basic auth) ──

# ── NimbusPost (shipping rates by pincode, cheapest courier) ──
NIMBUSPOST_PICKUP_PINCODE=305624

# ── Cloudinary (product photos, banners, admin uploads) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NIMBUSPOST_API_KEY=
NIMBUSPOST_WAREHOUSE_NAME=
NIMBUSPOST_WEBHOOK_SECRET=
NIMBUSPOST_API_SECRET=
ADMIN_SESSION_SECRET=          # long random string; admins are created with: pnpm admin:create <user> <password>

# ── Email (Resend) ──
RESEND_API_KEY=
MAIL_FROM="Swadeshi Mahadev <orders@swadeshimahadevproducts.com>"
STORE_ALERT_EMAIL=info.mahadevproducts@gmail.com
CRON_SECRET=

# ── WhatsApp automation (Interakt/WATI or another provider adapter) ──
# "meta" = WhatsApp Cloud API direct (needs API_KEY = permanent system-user token, PHONE_NUMBER_ID, VERIFY_TOKEN;
# APP_SECRET optional, enables webhook signature check). Any other value = generic relay at WHATSAPP_API_URL.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Login / verification OTP over WhatsApp (approved AUTHENTICATION template with a Copy code button).
# When set, it replaces the SMS relay below; no DLT registration needed.
WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_LANG=en
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=
WHATSAPP_WEBHOOK_SECRET=

# ── Optional customer phone OTP ──
CUSTOMER_OTP_PROVIDER=
CUSTOMER_OTP_API_KEY=
CUSTOMER_OTP_API_URL=

# Chat assistant (Google AI Studio key; free tier is fine)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Backup AI when Gemini fails (rate limit, outage, bad key): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Chat assistant voice (Dadi ji, ElevenLabs voice clone). Without these the chat uses the browser's Hindi voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: ELEVENLABS_MODEL=eleven_multilingual_v2
# Set to 1 once ELEVENLABS_* are filled, so the chat asks the server for Dadi ji's voice.
NEXT_PUBLIC_DADI_VOICE=
